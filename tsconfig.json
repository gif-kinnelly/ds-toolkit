{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "@figma/plugin-typings"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "plugins", "test", "scripts"]
}
